{
  "$schema": "https://unpkg.com/@changesets/config@3.0.0/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "actus-ag/llm-ui"
    }
  ],
  "commit": false,
  "fixed": [
    [
      "@actus-ag/llm-ui-svelte",
      "@actus-ag/llm-ui-markdown",
      "@actus-ag/llm-ui-svelte-code",
      "@actus-ag/llm-ui-svelte-json",
      "@actus-ag/llm-ui-svelte-csv"
    ]
  ],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "bumpVersionsWithWorkspaceProtocolOnly": true,
  "ignore": [
    "svelte-*-example",
    "@actus-ag/llm-ui-tsconfig"
  ],
  "snapshot": {
    "prereleaseTemplate": "{tag}.v{commit}"
  }
}
