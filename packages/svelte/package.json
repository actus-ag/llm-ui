    "@tsconfig/svelte": "^5.0.2",
    "@types/node": "^20",
    "svelte": "^4.2.8",
    "tsup": "^8.0.2",
    "typescript": "^5.4.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "remeda": "^1.57.0"
  }
